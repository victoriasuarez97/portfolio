---
import { experience } from "../data/experience";
---

<section id="path" class="section">
  <header class="section-header">
    <h2 class="section-kicker">01 — Path</h2>
    <span class="section-line" aria-hidden="true"></span>
    <span class="section-note">what I<span class="symbol">'</span>ve shipped, and with whom</span>
  </header>
  <p class="section-description">From illustration and tattoos to the web. Here's the path so far.</p>
  <div class="career-list">
    {experience.map((job) => (
      <article class="career-entry" data-reveal="">
        <div class="career-entry__meta"><div class="career-entry__period">{job.period}</div><div class="career-entry__location">{job.location}</div></div>
        <div>
          <div class="career-entry__heading"><h3 class="career-entry__role">{job.role}</h3><span class="career-entry__company">{job.company}</span></div>
          <p class="career-entry__description">{job.description}</p>
          <ul class="career-entry__bullets">{job.bullets.map((bullet) => <li><span class="career-entry__dash" aria-hidden="true">—</span><span>{bullet}</span></li>)}</ul>
          <div class="career-entry__technologies">{job.technologies.map((tech) => <span>{tech}</span>)}</div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
    .career-list {
        display: flex;
        flex-direction: column;
    }
    .career-entry {
        display: grid;
        grid-template-columns: 132px 1fr;
        gap: 26px;
        padding: 26px 0;
        border-top: 1.5px solid var(--border-color);
    }
    .career-entry__meta {
        padding-top: 4px;
    }
    .career-entry__period, .career-entry__location, .career-entry__technologies {
        font-family: var(--font-mono);
    }
    .career-entry__period {
        color: var(--color-soft);
        font-size: 11.5px;
        line-height: 1.6;
    }
    .career-entry__location {
        margin-top: 6px;
        color: var(--color-pale);
        font-size: 10px;
        letter-spacing: 0.1em; 
        text-transform: uppercase;
    }
    .career-entry__heading {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 10px;
    }
    .career-entry__role {
        margin: 0;
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.015em;
    }
    .career-entry__company {
        color: var(--color-orange);
        font-size: 14.5px;
    }
    .career-entry__description {
        max-width: 62ch;
        margin: 9px 0 0;
        color: var(--color-muted);
        font-size: 15.5px;
        line-height: 1.55;
        text-wrap: pretty;
    }
    .career-entry__bullets {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 14px 0 0;
        padding: 0;
        list-style: none;
    }
    .career-entry__bullets li {
        display: grid; 
        grid-template-columns: 16px 1fr;
        gap: 8px;
        max-width: 62ch;
        color: var(--color-body);
        font-size: 15px;
        line-height: 1.5;
        text-wrap: pretty;
    }
    .career-entry__dash {
        color: var(--color-accent-green);
        font-weight: 600;
    }
    .career-entry__technologies {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 14px;
    }
    .career-entry__technologies span {
        padding: 4px 9px;
        color: var(--color-tag-ink);
        background: rgb(228 232 140 / 35%);
        border-radius: 99px;
        font-size: 10.5px;
    }
    @media (max-width: 640px) {
        .career-entry {
            grid-template-columns: 1fr;
            gap: 12px;
        }
        .section-note {
            display: none;
        }
    }
</style>
