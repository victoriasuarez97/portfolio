---
import { experience } from "../data/experience";
---

<section id="path" style="scroll-margin-top:40px;padding:20px 0 90px">
      <div style="display:flex;align-items:baseline;gap:14px;margin-bottom:10px">
        <h2 style="margin:0;font-size:13px;font-family:'JetBrains Mono',monospace;letter-spacing:.2em;text-transform:uppercase;color:#7E8A5E">01 — Path</h2>
        <span style="flex:1;height:1.5px;background:#22301a1f"></span>
        <span style="font-family:Caveat,cursive;font-size:19px;color:#E2650E">what I've shipped, and with whom</span>
      </div>
      <p style="margin:0 0 30px;font-size:16px;line-height:1.6;color:#4A5840;max-width:60ch;text-wrap:pretty">Seven years across a US retail platform, a bank and a consultancy — plus six earlier ones drawing for clients.</p>

      <div style="display:flex;flex-direction:column">
        {experience.map((job) => (
             <div data-reveal="" style="display:grid;grid-template-columns:132px 1fr;gap:26px;padding:26px 0;border-top:1.5px solid #22301a14">
            <div style="padding-top:4px">
              <div style="font-family:'JetBrains Mono',monospace;font-size:11.5px;color:#8A9668;line-height:1.6">{job.period}</div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:#B2B896;margin-top:6px">{job.location}</div>
            </div>
            <div>
              <div style="display:flex;align-items:baseline;gap:10px;flex-wrap:wrap">
                <span style="font-size:19px;font-weight:600;letter-spacing:-.015em">{job.role}</span>
                <span style="font-size:14.5px;color:#E2650E">{job.company}</span>
              </div>
              <p style="margin:9px 0 0;font-size:15.5px;line-height:1.55;color:#4A5840;max-width:62ch;text-wrap:pretty">{job.description}</p>
              <ul style="margin:14px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px">
                {job.bullets.map((bullet) => (
                  <li style="display:grid;grid-template-columns:16px 1fr;gap:8px;font-size:15px;line-height:1.5;color:#3C4A32;max-width:62ch">
                        <span style="color:#A8BE3C;font-weight:600">—</span>
                        <span style="text-wrap:pretty">{bullet}</span>
                  </li>
                  ))}
              </ul>
              <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:14px">
                {job.technologies.map((tech) => (
                    <span style="font-family:'JetBrains Mono',monospace;font-size:10.5px;padding:4px 9px;border-radius:99px;background:#E4E88C59;color:#42501F">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>