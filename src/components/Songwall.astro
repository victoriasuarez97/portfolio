---
interface Song {
  id?: string;
  link: string;
  cover: string;
  title: string;
  artist: string;
  who: string;
  msg: string;
}

interface Props {
  songs?: Song[];
}

const { songs = [] } = Astro.props;
---

<section id="songs" class="song-wall">
  <header class="section-header">
    <h2 class="section-kicker">04 — Song wall</h2>
    <span class="section-line" aria-hidden="true"></span>
    <span class="section-note">the yapa</span>
  </header>

  <p class="section-description">
    Leave me something to listen to while I work. Paste a Spotify link,
    tell me why, and I'll pin it to the wall.
  </p>

  <form class="song-form" id="song-form">
    <div class="song-form__row">
      <label class="sr-only" for="spotify-link">Spotify track URL</label>
      <input
        id="spotify-link"
        name="spotifyLink"
        type="url"
        placeholder="https://open.spotify.com/track/…"
        class="song-input song-input--mono"
        required
      />

      <label class="sr-only" for="submitted-by">Your name</label>
      <input
        id="submitted-by"
        name="submittedBy"
        type="text"
        maxlength="28"
        placeholder="your name (or stay a mystery)"
        class="song-input"
      />
    </div>

    <label class="sr-only" for="song-message">
      Why are you recommending this song?
    </label>

    <input
      id="song-message"
      name="message"
      type="text"
      maxlength="140"
      placeholder="why this one? (140 characters, be dramatic)"
      class="song-input"
    />

    <div class="song-form__footer">
      <button type="submit" class="song-submit">
        Pin it to the wall
      </button>

      <p class="song-form__status" id="song-form-status" aria-live="polite"></p>
    </div>
  </form>

  <div class="song-grid">
    {
      songs.map((song) => (
        <article class="song-card">
          <div class="song-card__main">
            <img
              src={song.cover}
              alt=""
              width="74"
              height="74"
              class="song-card__cover"
            />

            <div class="song-card__info">
              <h3 class="song-card__title">{song.title}</h3>
              <p class="song-card__artist">{song.artist}</p>

              <div class="song-card__submitter">
                <span class="equalizer" aria-hidden="true">
                  <span />
                  <span />
                  <span />
                </span>

                <span>{song.who}</span>
              </div>
            </div>
          </div>

          <blockquote class="song-card__message">
            “{song.msg}”
          </blockquote>

          <div class="song-card__actions">
            <button
              type="button"
              class="song-card__play"
              data-spotify-url={song.link}
            >
              <span aria-hidden="true">▶</span>
              Play
            </button>

            <a
              href={song.link}
              target="_blank"
              rel="noreferrer"
              class="song-card__spotify-link"
            >
              Spotify ↗
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <button type="button" class="song-wall__more" hidden>
    See more ↓
  </button>
</section>

<style>
  .song-wall {
    scroll-margin-top: 40px;
    padding: var(--section-spacing);
  }

  .song-form {
    display: grid;
    gap: 12px;
    padding: 22px;
    background: var(--color-surface);
    border: 1.5px solid rgb(34 48 26 / 10%);
    border-radius: 14px;
  }

  .song-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .song-input {
    width: 100%;
    padding: 13px 14px;
    color: var(--color-ink);
    background: var(--color-paper);
    border: 1.5px solid rgb(34 48 26 / 15%);
    border-radius: 8px;
    outline: none;
    font: inherit;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .song-input--mono {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .song-input:focus-visible {
    border-color: var(--color-orange);
    box-shadow: 0 0 0 3px rgb(226 101 14 / 10%);
  }

  .song-form__footer {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .song-submit,
  .song-card__play {
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    font: inherit;
    font-weight: 500;
  }

  .song-submit {
    padding: 12px 20px;
    color: var(--color-paper);
    background: var(--color-ink);
    transition: background 150ms ease;
  }

  .song-submit:hover {
    background: var(--color-orange);
  }

  .song-form__status {
    margin: 0;
    font-size: 13.5px;
  }

  .song-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(268px, 100%), 1fr));
    gap: 14px;
    margin-top: 20px;
  }

  .song-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1.5px solid rgb(34 48 26 / 10%);
    border-radius: 14px;
    transition:
      transform 220ms cubic-bezier(0.2, 0.8, 0.3, 1),
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  .song-card:hover {
    transform: translate(-2px, -3px) rotate(-0.6deg);
    border-color: var(--color-ink);
    box-shadow: 5px 6px 0 var(--color-green);
  }

  .song-card__main {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .song-card__cover {
    flex: none;
    width: 74px;
    height: 74px;
    object-fit: cover;
    background: var(--color-green);
    border-radius: 8px;
  }

  .song-card__info {
    min-width: 0;
  }

  .song-card__title,
  .song-card__artist {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .song-card__title {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .song-card__artist {
    margin: 3px 0 0;
    color: var(--color-subtle);
    font-size: 13.5px;
  }

  .song-card__submitter {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    color: var(--color-soft);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .equalizer {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 11px;
  }

  .equalizer span {
    display: block;
    width: 2.5px;
    background: var(--color-equalizer);
  }

  .equalizer span:nth-child(1) {
    height: 5px;
  }

  .equalizer span:nth-child(2) {
    height: 11px;
  }

  .equalizer span:nth-child(3) {
    height: 8px;
  }

  .song-card__message {
    margin: 0;
    color: var(--color-body);
    font-family: var(--font-hand);
    font-size: 20px;
    line-height: 1.2;
    text-wrap: pretty;
  }

  .song-card__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 2px;
  }

  .song-card__play {
    padding: 8px 12px;
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .song-card__spotify-link {
    color: var(--color-subtle);
    font-size: 13px;
    text-decoration: none;
  }

  .song-card__spotify-link:hover {
    color: var(--color-orange);
  }

  .song-wall__more {
    margin-top: 18px;
  }

  .song-wall__footnote {
    margin-top: 16px;
    color: var(--color-soft);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .song-form__row {
      grid-template-columns: 1fr;
    }

    .section-note {
      display: none;
    }

    .song-form__footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
