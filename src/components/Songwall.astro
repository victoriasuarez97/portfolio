---
interface Song {
  id?: string;
  link: string;
  cover: string;
  title: string;
  artist: string;
  who: string;
  msg: string;
}

interface Props { songs?: Song[]; }
const { songs = [] } = Astro.props;
---

<section id="songs" class="section song-wall" data-initial-songs={JSON.stringify(songs)}>
  <header class="section-header">
    <h2 class="section-kicker">04 — Song wall</h2>
    <span class="section-line" aria-hidden="true"></span>
    <span class="section-note">the yapa</span>
  </header>

  <p class="section-description">
    Paste a Spotify track link, add a note if you like, and make a little soundtrack.
    Your songs stay in this browser.
  </p>
  <p class="song-wall__aside-note" aria-hidden="true">psst, this bit draws back ↘</p>

  <form class="song-form" id="song-form">
    <div class="song-form__row">
      <label class="sr-only" for="spotify-link">Spotify track link (required)</label>
      <input id="spotify-link" name="spotifyLink" type="url" placeholder="https://open.spotify.com/track/…" class="song-input song-input--mono" required />
      <label class="sr-only" for="submitted-by">Your name (optional)</label>
      <input id="submitted-by" name="submittedBy" type="text" maxlength="28" placeholder="your name (optional)" class="song-input" />
    </div>
    <label class="sr-only" for="song-message">A note about this song (optional, up to 140 characters)</label>
    <input id="song-message" name="message" type="text" maxlength="140" placeholder="why this one? (140 max)" class="song-input" />
    <div class="song-form__footer">
      <button type="submit" class="song-submit">Pin it to the wall</button>
      <p class="song-form__status" id="song-form-status" aria-live="polite"></p>
    </div>
  </form>

  <div class="song-wall__collection" data-song-collection hidden>
    <div class="song-wall__now-playing">
      <div class="record-player">
        <div class="record-player__copy">
          <p class="record-player__eyebrow"><span></span> Now playing</p>
          <h3 class="record-player__title" data-current-title></h3>
          <p class="record-player__artist" data-current-artist></p>
          <div class="record-player__meta">
            <span class="record-player__rpm">33 RPM</span>
            <span data-current-who></span>
          </div>
        </div>
        <div class="turntable" aria-hidden="true">
          <div class="turntable__record">
            <span class="turntable__label"></span>
            <span class="turntable__spindle"></span>
          </div>
          <div class="turntable__arm">
            <span class="turntable__pivot"></span>
            <span class="turntable__needle"></span>
          </div>
        </div>
      </div>
      <blockquote class="song-wall__message" data-current-message></blockquote>
      <div class="song-wall__embed" data-current-embed aria-live="polite"></div>
    </div>

    <aside class="song-wall__playlist" aria-label="Songs pinned to the wall">
      <p class="song-wall__side-title">Side A: the wall so far</p>
      <ol class="song-wall__track-list" data-track-list></ol>
    </aside>
  </div>

  <p class="song-wall__empty" data-song-empty>Your wall is waiting for its first song. Pick a track to get started.</p>
</section>

<script src="../scripts/songwall.ts"></script>

<style is:global>
  .song-wall { container-type: inline-size; }
  .song-wall__aside-note { width: max-content; margin: -18px 0 20px 5px; color: var(--color-subtle); font-family: var(--font-hand); font-size: 20px; transform: rotate(-3deg); }
  .song-form { display: grid; gap: 12px; padding: 22px; background: var(--color-surface); border: 1.5px solid var(--border-color); border-radius: 14px; }
  .song-form__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .song-input { width: 100%; min-width: 0; padding: 13px 14px; color: var(--color-ink); background: var(--color-paper); border: 1.5px solid var(--border-color-strong); border-radius: 8px; outline: none; font: inherit; transition: border-color 150ms ease, box-shadow 150ms ease; }
  .song-input--mono { font-family: var(--font-mono); font-size: 13px; }
  .song-input:focus-visible { border-color: var(--color-orange); box-shadow: 0 0 0 3px rgb(226 101 14 / 10%); }
  .song-form__footer { display: flex; align-items: center; gap: 14px; }
  .song-submit { min-height: 44px; padding: 12px 20px; color: var(--color-paper); background: var(--color-ink); border: 0; border-radius: 8px; cursor: pointer; font: inherit; font-weight: 600; transition: background 150ms ease, transform 150ms ease; }
  .song-submit:hover { background: var(--color-orange); transform: translateY(-1px); }
  .song-submit:disabled { cursor: wait; opacity: .65; }
  .song-form__status { margin: 0; color: var(--color-orange); font-family: var(--font-hand); font-size: 18px; }

  .song-wall__collection { margin-top: 20px; }
  .song-wall__collection[hidden], .song-wall__empty[hidden] { display: none; }
  .song-wall__now-playing { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 1fr); grid-template-areas: "deck embed" "message embed"; gap: 0 22px; align-items: center; }
  .record-player { grid-area: deck; }
  .record-player { display: grid; grid-template-columns: minmax(0, 1fr) 170px; min-height: 196px; padding: 20px 16px 18px 20px; overflow: hidden; color: var(--color-paper); background: var(--color-ink); border-radius: 15px; box-shadow: 0 7px 0 rgb(34 48 26 / 12%); }
  .record-player__copy { display: flex; flex-direction: column; min-width: 0; padding: 22px 0 8px; }
  .record-player__eyebrow, .record-player__meta { font-family: var(--font-mono); font-size: 10px; letter-spacing: .17em; text-transform: uppercase; }
  .record-player__eyebrow { display: flex; align-items: center; gap: 8px; margin: 0 0 13px; color: var(--color-pale); }
  .record-player__eyebrow span { width: 8px; height: 8px; background: var(--color-orange); border-radius: 50%; box-shadow: 0 0 8px rgb(226 101 14 / 75%); }
  .record-player__title { margin: 0; overflow: hidden; font-family: var(--font-hand); font-size: 25px; font-weight: 400; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
  .record-player__artist { margin: 9px 0 12px; overflow: hidden; color: var(--color-pale); font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
  .record-player__meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin-top: auto; color: var(--color-pale); }
  .record-player__meta [data-current-who] { min-width: 0; overflow-wrap: anywhere; }
  .record-player__rpm { padding: 5px 8px; color: var(--color-ink); background: var(--color-green); border-radius: 3px; }

  .turntable { position: relative; display: grid; place-items: center; align-self: center; width: 170px; height: 170px; }
  .turntable__record { position: relative; display: grid; place-items: center; width: 150px; height: 150px; background: repeating-radial-gradient(circle, transparent 0 3px, rgb(255 255 255 / 5%) 3.5px 4px), radial-gradient(circle, #172013 0 69%, #0e140c 70% 100%); border-radius: 50%; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 4%), 0 5px 18px rgb(0 0 0 / 28%); animation: spinRecord 4s linear infinite; animation-play-state: paused; }
  .song-wall--playing .turntable__record { animation-play-state: running; }
  .turntable__record::before { content: ""; position: absolute; inset: 7px; background: conic-gradient(from 205deg, transparent 0 12%, rgb(255 255 255 / 3%) 16%, rgb(255 255 255 / 10%) 20%, rgb(255 255 255 / 2%) 25%, transparent 31% 62%, rgb(255 255 255 / 6%) 67%, transparent 73%); border-radius: 50%; mix-blend-mode: screen; pointer-events: none; }
  .turntable__label { position: relative; z-index: 1; width: 53px; height: 53px; background: var(--color-green); border: 2px solid var(--color-orange); border-radius: 50%; box-shadow: inset 0 0 0 4px var(--color-paper); }
  .turntable__spindle { position: absolute; z-index: 2; width: 9px; height: 9px; background: var(--color-ink); border-radius: 50%; }
  .turntable__arm { position: absolute; top: 9px; right: 7px; width: 8px; height: 94px; background: #d7d3b5; border-radius: 8px; box-shadow: 1px 1px 2px rgb(0 0 0 / 35%); transform: rotate(32deg); transform-origin: 50% 8px; }
  .turntable__arm::after { content: ""; position: absolute; top: 82px; left: 0; width: 8px; height: 31px; background: #d7d3b5; border-radius: 4px 4px 7px 7px; box-shadow: 1px 1px 2px rgb(0 0 0 / 30%); transform: rotate(27deg); transform-origin: 4px 4px; }
  .turntable__pivot { position: absolute; top: -4px; left: -6px; width: 20px; height: 20px; background: #70795a; border: 2px solid #ddd9b9; border-radius: 50%; }
  .turntable__needle { position: absolute; z-index: 1; bottom: -27px; left: -12px; width: 17px; height: 13px; background: var(--color-orange); border-radius: 3px 2px 5px 2px; box-shadow: 1px 2px 3px rgb(0 0 0 / 28%); transform: rotate(27deg); }

  .song-wall__message { grid-area: message; min-width: 0; min-height: 38px; margin: 13px 4px 8px; overflow-wrap: anywhere; color: var(--color-orange); font-family: var(--font-hand); font-size: 21px; line-height: 1.2; transform: rotate(-1deg); }
  .song-wall__embed { position: relative; grid-area: embed; overflow: hidden; height: 152px; background: #191919; border-radius: 13px; }
  .song-wall__embed--loading::after { content: "Loading track…"; position: absolute; z-index: 1; inset: 0; display: grid; place-items: center; color: var(--color-pale); background: #191919; font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .song-wall__embed--loading::before { content: ""; position: absolute; z-index: 2; top: calc(50% - 24px); left: calc(50% - 7px); width: 14px; height: 14px; border: 2px solid rgb(255 255 255 / 22%); border-top-color: var(--color-green); border-radius: 50%; animation: spinLoader .7s linear infinite; }
  .song-wall__embed iframe { width: 100%; height: 152px; border: 0; }
  .song-wall__playlist { width: 100%; margin-top: 18px; padding: 16px 10px 12px; background: var(--color-surface); border: 1.5px solid var(--border-color); border-radius: 15px; }
  .song-wall__side-title { margin: 0 8px 8px; color: var(--color-soft); font-family: var(--font-mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; }
  .song-wall__track-list { display: grid; gap: 3px; padding: 0; margin: 0; list-style: none; }
  .song-wall__track { display: grid; grid-template-columns: 28px minmax(0, 1.8fr) minmax(16px, 1fr) minmax(0, 1fr) minmax(0, .7fr); align-items: center; width: 100%; min-height: 44px; gap: 10px; padding: 10px 8px; color: var(--color-ink); background: transparent; border: 0; border-radius: 9px; cursor: pointer; text-align: left; transition: background 160ms ease; }
  .song-wall__track:hover { background: rgb(228 232 140 / 38%); }
  .song-wall__track--active { background: var(--color-green); }
  .song-wall__track-number, .song-wall__track-who { color: var(--color-soft); font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; }
  .song-wall__track-title, .song-wall__track-artist, .song-wall__track-who { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .song-wall__track-title { font-family: var(--font-hand); font-size: 19px; }
  .song-wall__track-dots { height: 1px; border-top: 1px dotted var(--color-pale); }
  .song-wall__track-artist { color: var(--color-subtle); font-size: 12px; }
  .song-wall__empty { margin: 20px 0 0; padding: 30px; color: var(--color-subtle); background: var(--color-surface); border: 1.5px dashed var(--border-color-strong); border-radius: 14px; font-family: var(--font-hand); font-size: 22px; text-align: center; }
  .song-wall__footnote { margin: 16px 0 0; color: var(--color-soft); font-family: var(--font-mono); font-size: 10px; line-height: 1.45; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @keyframes spinRecord { to { transform: rotate(360deg); } }
  @keyframes spinLoader { to { transform: rotate(360deg); } }
  @container (max-width: 700px) {
    .song-wall__now-playing { grid-template-columns: 1fr; grid-template-areas: "deck" "message" "embed"; gap: 0; }
  }
  @container (max-width: 480px) {
    .song-form { padding: 16px; }
    .song-form__row { grid-template-columns: 1fr; }
    .song-form__footer { align-items: flex-start; flex-direction: column; }
    .song-submit { width: 100%; }
    .song-input--mono { font-size: 16px; }
    .record-player { grid-template-columns: minmax(0, 1fr) 125px; min-height: 164px; padding: 14px; }
    .turntable { width: 125px; height: 135px; }
    .turntable__record { width: 116px; height: 116px; }
    .turntable__arm { right: 1px; height: 73px; }
    .song-wall__track { grid-template-columns: 22px minmax(0, 1fr) minmax(55px, .7fr); gap: 8px; }
    .song-wall__track-who, .song-wall__track-dots { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .turntable__record, .song-wall__embed--loading::before { animation: none; }
  }
</style>
