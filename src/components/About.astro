---
import { Image } from "astro:assets";
import catLounge from "../assets/cat-lounge.png";
---

<section id="about" class="section">
    <div class="section-header">
        <h2 class="section-kicker">03 — About</h2>
        <span class="section-line" aria-hidden="true"></span>
    </div>
    <div class="about_container">
        <div>
            <p class="about_highlighted_text">I'm 29, I live in Buenos Aires with two cats named Renton and Zeldita, and I've been drawing for as long as I've been solving problems.</p>
            <p class="about_description">For six years, I paid rent with editorial illustration, tattoos and a lot of gouache-looking cats. That's where I learned composition, patience and how to take feedback without crying. Then I moved into engineering, and it turned out to be the same job with different tools: look at the problem, sketch, iterate, ship.</p>
            <p class="about_description">Today I lead admin tooling for a US retail platform, keep a Storybook library honest on a team with no designer, and build small AI experiments because they're fun.</p>
        </div>
        <div class="about_image_container">
            <Image src={catLounge} alt="Zeldita taking a nap" style="width:100%;height:auto;display:block" width={420} densities={[1, 2]} />
            <p class="about_image_text">zeldita haciendo la siesta, 2022</p>
        </div>
    </div>
</section>

<style>
  .about_container {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: 44px;
    align-items: start;
  }

  .about_highlighted_text {
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .about_description {
    margin: 20px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .about_image_container {
    background: var(--color-surface);
    border: 1.5px solid var(--border-color);
    border-radius: 14px;
    padding:14px;
  }

  .about_image_text {
    font-family: var(--font-hand);
    font-size: 25px;
    color: var(--color-subtle);
    text-align: center;
    margin-top: 6px;
  }
  @media (max-width: 700px) {
    .about_container {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .about_image_container {
      width: 100%;
      max-width: 420px;
      justify-self: center;
    }
  }
</style>
