---
import { Image } from "astro:assets";
import catClack from "../assets/cat-clack.png";
---

<aside class="sidebar">
  <div>
    <p class="sidebar__name">Vicky<span class="sidebar__surname"> Suarez</span></p>
    <p class="sidebar__role">
      frontend <span class="symbol">&amp;</span> craft
    </p>
  </div>

  <nav class="sidebar__nav" aria-label="Main navigation">
    <a href="#path">01 · Path</a>
    <a href="#work">02 · Playground</a>
    <a href="#about">03 · About</a>
    <a href="#songs">04 · Song wall</a>
    <a href="#hello">05 · Say hi</a>
  </nav>

  <div class="sidebar__companions">
    <div class="sidebar__illustration"><Image src={catClack} alt="Los pupinos" width={240} densities={[1, 2]} /></div>
    <p class="sidebar__credits">RENTON — SUPERVISOR<br />ZELDITA — QA</p>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
    height: 100vh;
    padding: 38px 26px 26px;
    border-right: 1.5px solid rgb(34 48 26 / 12%);
  }
  .sidebar__location, .sidebar__credits {
    color: var(--color-subtle);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }
  .sidebar__name {
    margin: 10px 0 0;
    font-size: 29px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .sidebar__role {
    margin: 4px 0 0;
    color: var(--color-orange);
    font-family: var(--font-hand);
    font-size: 33px;
  }
  .sidebar__nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14.5px;
  }
  .sidebar__nav a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 7px 10px;
    color: var(--color-ink);
    border-radius: 6px;
    transition: background 150ms ease;
  }
  .sidebar__nav a:hover {
    color: var(--color-ink);
    background: rgb(228 232 140 / 40%);
  }
  .sidebar__companions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: auto;
  }
  .sidebar__illustration {
    transition: transform 350ms cubic-bezier(0.2, 0.8, 0.3, 1);
    will-change: transform;
  }
  .sidebar__illustration:hover {
    transform: rotate(2deg) translateY(-3px);
  }
  .sidebar__illustration img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sidebar__credits {
    margin: 0;
    font-size: 10px;
    line-height: 1.7;
  }
  .sidebar__surname {
    display: block;
  }
  @media (max-width: 1024px) {
    .sidebar {
      position: static;
      height: auto;
      gap: 18px;
      padding: 24px 32px;
      border-right: 0;
      border-bottom: 1.5px solid var(--border-color);
    }
    .sidebar__surname {
      display: inline;
    }
    .sidebar__nav {
      flex-flow: row wrap;
    }
    .sidebar__companions {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .sidebar {
      padding: 20px;
    }
    .sidebar__name {
      margin-top: 0;
      font-size: 26px;
    }
    .sidebar__role {
      font-size: 28px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sidebar__illustration {
      transition: none;
    }
  }
</style>
